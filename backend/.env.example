# IALM 后端环境变量（参考配置）
# 复制此文件为 .env 并填入实际值

# 数据库连接（DATABASE_URL 优先，否则用 MYSQL_* 构建）
# URL 中 @ 需 URL 编码为 %40
DATABASE_URL=mysql+pymysql://ialm:Ialm%402026@127.0.0.1:3306/ialm_db?charset=utf8mb4

# 备用：分别指定（被 DATABASE_URL 覆盖）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ialm
MYSQL_PASSWORD=Ialm@2026
MYSQL_DATABASE=ialm_db

# JWT
SECRET_KEY=ialm-secret-key-please-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS（前端域名）
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,https://wxfzhh.online

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# DeepSeek LLM
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 应用
APP_NAME=IALM 保险资产负债管理智能分析平台
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO